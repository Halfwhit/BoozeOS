/*
 * Booze OS — Calamares stylesheet
 * Dark navy base with amber accent
 */

/* Main window */
#mainApp {
    background-color: #1c1c2e;
    color: #ffffff;
}

/* Sidebar */
#sidebarApp {
    background-color: #1c1c2e;
    color: #ffffff;
}

#sidebarMenuApp {
    background-color: #1c1c2e;
}

/* Step items in sidebar */
.menuItem {
    color: #aaaacc;
    padding: 6px;
}

.menuItem:selected,
.menuItem:focus {
    background-color: #e8a020;
    color: #1c1c2e;
    border-radius: 4px;
}

/* Buttons */
QPushButton {
    background-color: #e8a020;
    color: #1c1c2e;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #f0b030;
}

QPushButton:pressed {
    background-color: #c07010;
}

QPushButton:disabled {
    background-color: #444466;
    color: #888888;
}

/* Progress bar */
QProgressBar {
    background-color: #2e2e4e;
    border: none;
    border-radius: 4px;
    height: 8px;
}

QProgressBar::chunk {
    background-color: #e8a020;
    border-radius: 4px;
}
